rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 블로그 주인 계정만 쓰기 가능. src/lib/firebase.ts의 OWNER_EMAIL과 같은 값이어야 해요.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'dpshr2000@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidPost(data) {
      return data.keys().hasOnly([
          'title', 'content', 'recordedAt', 'mood', 'weather', 'place', 'tags',
          'authorEmail', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.content is string && data.content.size() <= 20000
        && data.recordedAt is timestamp
        // 기분·날씨·장소·태그는 3단계에서 추가돼서, 없는 기록도 허용해요.
        && data.get('mood', '') is string && data.get('mood', '').size() <= 16
        && data.get('weather', '') in ['', 'sunny', 'partly', 'cloudy', 'rain', 'snow']
        && data.get('place', '') is string && data.get('place', '').size() <= 100
        && data.get('tags', []) is list && data.get('tags', []).size() <= 10
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isOwner()
        && isValidPost(request.resource.data)
        && request.resource.data.authorEmail == request.auth.token.email;
      allow update: if isOwner()
        && isValidPost(request.resource.data)
        && request.resource.data.authorEmail == resource.data.authorEmail
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
